node_modules/
dist/
site/
.vite/
*.local
.DS_Store
# Python test environment
.venv/
__pycache__/
.pytest_cache/
test-results/
*.tsbuildinfo
# TypeScript project-reference output. Kept out of the tree entirely: a stale
# emitted vite.config.js once shadowed vite.config.ts (Vite prefers .js) and
# silently froze the build's base path.
dist-types/
apps/*/vite.config.js
apps/*/vite.config.d.ts

# Capacitor: everything here is produced from apps/web's native build.
apps/web/dist-native/
apps/mobile/www/
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/app/src/main/assets/capacitor.config.json
apps/mobile/ios/App/App/public/
apps/mobile/ios/App/App/capacitor.config.json
