<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a .gpx from Files, Drive, or a mail attachment, and
              sharing one into the app. Both reach MainActivity, which reads
              the file and hands it to the web layer.

              The MIME list is long because there is no type everyone agrees
              a .gpx has: providers variously report application/gpx+xml,
              application/xml, text/xml or application/octet-stream, and the
              one you get depends on which app is doing the sending. The same
              disagreement is why an `accept` filter on the file picker greys
              out the file you are reaching for.

              octet-stream is the cost of that: it also offers this app in
              the chooser for other unrecognised files. Without it the most
              common case — an attachment saved to Downloads — does not
              offer the app at all, which is worse. Anything that is not a
              route is rejected by the parser, and says so.
            -->
            <intent-filter android:label="@string/import_gpx">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- A sender that supplies no type at all, which only file:// does. -->
            <intent-filter android:label="@string/import_gpx">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.gpx" />
            </intent-filter>

            <intent-filter android:label="@string/import_gpx">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <service
            android:name=".TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Location. FINE is the point of the app: matching to a footpath needs
      metres, and COARSE alone cannot tell which side of a valley you are on.
      Both are declared because Android asks for them as a pair, and a user
      who grants only approximate location should still get a working map
      rather than a broken screen.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Keeps the screen awake while tracking, behind the menu toggle. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Recording the walk with the screen off.

      A foreground service of type `location`, started while the app is on
      screen, keeps the ordinary while-in-use location permission alive for as
      long as it runs — so ACCESS_BACKGROUND_LOCATION is deliberately absent.
      It would gain nothing here and is a far larger thing to ask of someone.

      POST_NOTIFICATIONS is for the notification the service must show; the
      service still runs if it is refused, it is simply not seen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The off-track buzz. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      GPS hardware is preferred but not required: the app is still useful in
      preview mode on a device without it, so do not let this exclude
      tablets from installing.
    -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
</manifest>
